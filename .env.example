# Web
MEDIA_STUDIO_APP_ENV=development
# Optional: leave these blank for the startup scripts to derive them from MEDIA_STUDIO_API_HOST and MEDIA_STUDIO_API_PORT.
NEXT_PUBLIC_MEDIA_STUDIO_CONTROL_API_BASE_URL=
MEDIA_STUDIO_CONTROL_API_BASE_URL=
# Optional: set to 1 to enable the experimental Graph Studio Media Assistant
# in both the web app and API. Leave blank for normal releases.
NEXT_PUBLIC_MEDIA_STUDIO_ASSISTANT_DEBUG=
# Optional, experimental: comma-separated provider kinds (local_openai, openrouter) that may
# drive the Media Assistant tool kernel through the OpenAI-compatible runtime instead of
# Codex Local. Leave blank for normal use. See docs/assistant-runtime-contract.md.
MEDIA_ASSISTANT_EXPERIMENTAL_RUNTIMES=
# Run the Media Assistant on Claude through Merge Gateway (https://docs.merge.dev/merge-gateway).
# Set MEDIA_ASSISTANT_PROVIDER=merge_gateway to select it; blank keeps Codex Local.
# MERGE_BASE_URL may be .../v1 or .../v1/openai; /v1/openai is always used.
MEDIA_ASSISTANT_PROVIDER=
# Or run it on a local MTPLX server (https://mtplx.com): MEDIA_ASSISTANT_PROVIDER=mtplx. No key needed.
# MTPLX_THINKING=1 lets the model think before each step (slower, may be better).
MTPLX_BASE_URL=http://127.0.0.1:8000/v1
MTPLX_MODEL=mtplx
MTPLX_THINKING=
# Set to 1 to stream OpenAI-compatible assistant calls so Stop closes the connection.
# Merge Gateway buffers its streams, so this gains nothing there (see docs/assistant-claude-improvement-plan.md).
MEDIA_ASSISTANT_STREAM=
MERGE_API_KEY=
MERGE_MODEL=anthropic/claude-sonnet-5-5
MERGE_BASE_URL=https://api-gateway.merge.dev/v1/openai
# Internal web->API token. Keep the same value for both the Next app and FastAPI.
# Generate a unique random value for your machine or deployment.
MEDIA_STUDIO_CONTROL_API_TOKEN=replace_with_a_unique_control_token
# Non-secret local install identity used to isolate browser-side Studio state.
MEDIA_STUDIO_INSTALL_ID=replace_with_a_unique_install_id
# Optional: set both values if you want browser auth outside strict localhost-only use.
MEDIA_STUDIO_ADMIN_USERNAME=
MEDIA_STUDIO_ADMIN_PASSWORD=
# Optional: allow access from private LAN / TailScale addresses without browser auth.
MEDIA_STUDIO_ALLOW_PRIVATE_NETWORK_ACCESS=false
# Optional extra Next.js dev origins for private LAN / TailScale browser access.
# Usually not needed when MEDIA_STUDIO_ALLOW_PRIVATE_NETWORK_ACCESS=true.
MEDIA_STUDIO_ALLOWED_DEV_ORIGINS=

# API
MEDIA_STUDIO_API_HOST=127.0.0.1
MEDIA_STUDIO_API_PORT=8000
MEDIA_STUDIO_DB_PATH=/absolute/path/to/media-studio/data/media-studio.db
MEDIA_STUDIO_DATA_ROOT=/absolute/path/to/media-studio/data
MEDIA_STUDIO_KIE_API_REPO_PATH=/absolute/path/to/kie-api
MEDIA_STUDIO_SUPERVISOR=manual
# Required for live submits after you get your key:
# https://kie.ai?ref=e7565cf24a7fad4586341a87eaf21e42
MEDIA_ENABLE_LIVE_SUBMIT=false
MEDIA_BACKGROUND_POLL_ENABLED=true
MEDIA_POLL_SECONDS=6
MEDIA_PRICING_CACHE_HOURS=6
MEDIA_REFERENCE_IMPORT_MAX_BYTES=104857600
KIE_API_KEY=your_kie_api_key_here

# Optional prompt enhancement providers
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MEDIA_LOCAL_OPENAI_BASE_URL=
MEDIA_LOCAL_OPENAI_API_KEY=
